<Project>
  <PropertyGroup>
    <Authors>YourAdapterTeam</Authors>
    <Company>YourAdapterCompany</Company>
    <Copyright>Copyright (c) 2018-2026 AVEVA Group Limited. All rights reserved.</Copyright>
    <MajorVersion Condition="$(MajorVersion) == ''">2</MajorVersion>
    <MinorVersion Condition="$(MinorVersion) == ''">1</MinorVersion>
    <PatchVersion Condition="$(BuildNumber) == ''">0</PatchVersion>
    <Version>$(MajorVersion).$(MinorVersion).$(PatchVersion)</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
