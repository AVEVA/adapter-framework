<Project>
  <PropertyGroup>
    <Authors>AVEVA Group Limited</Authors>
    <Company>AVEVA Group Limited</Company>
    <Product>AVEVA Adapter Framework</Product>
    <Copyright>© 2018-2026 AVEVA Group Limited</Copyright>
    <!-- When updating this Version property, make sure the versions of SignalGenerator, FunctionalTests, AdapterTemplate, and PerformanceAdapter are in sync -->
    <MajorVersion Condition="$(MajorVersion) == ''">2</MajorVersion>
    <MinorVersion Condition="$(MinorVersion) == ''">1</MinorVersion>
    <PatchVersion Condition="$(BuildNumber) == ''">0</PatchVersion>
    <Version>$(MajorVersion).$(MinorVersion).$(PatchVersion)</Version>
    <!-- Do not append the source control revision hash (e.g. +abc1234) to the AssemblyInformationalVersion -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <IsSystemHostsProject>$(MSBuildProjectName.Contains('System.Hosts.csproj'))</IsSystemHostsProject>
    <!-- Code analysis ruleset settings shared by all projects -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <!-- CA1014: Mark assemblies with CLSCompliant (cannot be disabled in .editorconfig: https://github.com/dotnet/roslyn-analyzers/issues/4400) -->
    <!-- CS1591: Missing XML comment for publicly visible type or member -->
    <NoWarn>CA1014;CS1591</NoWarn>
    <_SkipUpgradeNetAnalyzersNuGetWarning>true</_SkipUpgradeNetAnalyzersNuGetWarning>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <Choose>
    <When Condition="'$(IsSystemHostsProject)' != 'true'">
      <PropertyGroup>
        <!-- Publish the repository URL in the built .nupkg (in the NuSpec <Repository> element) -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <!-- Embed source files that are not tracked by the source control manager in the PDB -->
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <!-- Build symbol package (.snupkg) to distribute the PDB containing Source Link -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <!-- NuGet.org publishing compliance metadata (traceability, licensing, provenance) -->
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/AVEVA/adapter-framework</PackageProjectUrl>
        <RepositoryUrl>https://github.com/AVEVA/adapter-framework</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>AVEVA;Adapter;AdapterFramework;PI;CONNECT;IoT;Industrial</PackageTags>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Description Condition="'$(Description)' == ''">$(Product) - $(MSBuildProjectName). Part of the Adapter Framework used to build data adapters for AVEVA CONNECT and PI System.</Description>

        <!-- Deterministic, reproducible builds for signed/published packages -->
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>
      </PropertyGroup>
      <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.103" PrivateAssets="All"/>
      </ItemGroup>
      <ItemGroup>
        <!-- Embed the package README so it renders on NuGet.org -->
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
      </ItemGroup>
    </When>
  </Choose>
  <Import Project="CodeAnalysis.props" />
</Project>
