    {
      "name": "Weather.gov Discovery Helpers",
      "description": "Use these requests to discover stations, then build DataSelection payloads. The running host currently does not expose a Discoveries facet endpoint.",
      "item": [
        {
          "name": "Start Discovery (autoSelect=true)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"west-coast-seeds\",\n  \"query\": \"47.61,-122.33;45.52,-122.67\",\n  \"autoSelect\": true\n}"
            },
            "url": {
              "raw": "{{hostBaseUrl}}/api/v1/Configuration/{{componentId}}/discoveries",
              "host": [
