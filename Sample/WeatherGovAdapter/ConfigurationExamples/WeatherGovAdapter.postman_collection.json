        {
          "name": "Put Adapter Schedules",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  { \"id\": \"1\", \"period\": \"00:01:00\" },\n  { \"id\": \"2\", \"period\": \"00:05:00\" },\n  { \"id\": \"3\", \"period\": \"00:10:00\" }\n]"
            },
            "url": {
              "raw": "{{hostBaseUrl}}/api/v1/configuration/{{componentId}}/Schedules",
              "host": [
                "{{hostBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "configuration",
                "{{componentId}}",
                "Schedules"
              ]
            },
            "description": "Defines the three selectable schedules: id 1 = 1 min, id 2 = 5 min, id 3 = 10 min. period is a TimeSpan (hh:mm:ss). DataSelection items pick one via scheduleId. weather.gov is rate-limited, so the fastest option is one minute."
          }
        }
      ]
