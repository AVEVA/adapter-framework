            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseUrl\": \"https://api.weather.gov\",\n  \"requestTimeoutMs\": 10000,\n  \"maxRetries\": 3,\n  \"retryBackoffMs\": 1000,\n  \"userAgent\": \"WeatherGovAdapterSample/1.0 (support@example.com)\",\n  \"streamIdPrefix\": \"{{streamIdPrefix}}\",\n  \"dropNullMeasurements\": true\n}"
            },
            "url": {
              "raw": "{{hostBaseUrl}}/api/v1/configuration/{{componentId}}/DataSource",
              "host": [
                "{{hostBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "configuration",
                "{{componentId}}",
                "DataSource"
              ]
            }
          }
        },
        {
          "name": "Get Adapter DataSelection",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "var count = Array.isArray(body) ? body.length : 0;",
                  "pm.environment.set('lastDataSelectionCount', String(count));",
                  "pm.test('DataSelection array returned', function () {",
                  "  pm.expect(Array.isArray(body)).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{hostBaseUrl}}/api/v1/configuration/{{componentId}}/DataSelection",
              "host": [
                "{{hostBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "configuration",
                "{{componentId}}",
                "DataSelection"
              ]
            }
          }
        },
        {
          "name": "Put Adapter DataSelection (Replace)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"id\": \"weathergov.station.KSEA\",\n    \"name\": \"Seattle NOAA Station\",\n    \"selected\": true,\n    \"stationId\": \"KSEA\",\n    \"includeFields\": [\n      \"timestamp\",\n      \"temperature_c\",\n      \"dewpoint_c\",\n      \"relative_humidity_pct\",\n      \"wind_speed_mps\",\n      \"wind_direction_deg\",\n      \"barometric_pressure_pa\",\n      \"visibility_m\",\n      \"text_description\"\n    ],\n    \"scheduleId\": \"1\",\n    \"streamId\": \"{{streamIdPrefix}}.station.KSEA\"\n  },\n  {\n    \"id\": \"weathergov.station.KPDX\",\n    \"name\": \"Portland NOAA Station\",\n    \"selected\": true,\n    \"stationId\": \"KPDX\",\n    \"includeFields\": [\n      \"timestamp\",\n      \"temperature_c\",\n      \"dewpoint_c\",\n      \"relative_humidity_pct\",\n      \"wind_speed_mps\",\n      \"wind_direction_deg\",\n      \"barometric_pressure_pa\",\n      \"visibility_m\",\n      \"text_description\"\n    ],\n    \"scheduleId\": \"2\",\n    \"streamId\": \"{{streamIdPrefix}}.station.KPDX\"\n  }\n]"
            },
            "url": {
              "raw": "{{hostBaseUrl}}/api/v1/configuration/{{componentId}}/DataSelection",
              "host": [
                "{{hostBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "configuration",
                "{{componentId}}",
                "DataSelection"
              ]
            }
          }
        },
